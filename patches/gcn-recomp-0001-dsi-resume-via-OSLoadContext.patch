+// A synchronous exception (a DSI, say) whose handler does not always end in an rfi: it may
+// mark the current context as an exception context, park the thread while it waits for
+// something, and resume it later with OSLoadContext. Bind the current context to the
+// caller's resume point the way irq_deliver does, writing the context first as the handler
+// will (SRR0 being the link register here), so the binding's stamp matches what the
+// handler leaves. Returns the jmp_buf to GCN_SETJMP on, or null with no current context.
+// exc_unbind drops it again when the handler returned by rfi instead.
+jmp_buf* exc_bind_current(CPU* c, uint32_t srr0) {
+    uint32_t ctx = mem_r32(0x800000D4);  // OSCurrentContext
+    if (!ctx || (ctx & 0x3FFFFFFF) >= RAM_SIZE) return nullptr;
+    Binding* b = &g_bindings[ctx];
+    b->h = t_self;
+    b->kind = BIND_EXC;
+    b->snapshot = *c;
+    cpu_to_context(c, ctx, srr0);
+    binding_stamp(b, ctx);
+    return &b->jb;
+}
+
+void exc_unbind(CPU* c) {
+    uint32_t ctx = mem_r32(0x800000D4);
+    auto it = g_bindings.find(ctx);
+    if (it != g_bindings.end() && it->second.h == t_self && it->second.kind == BIND_EXC) it->second.kind = BIND_NONE;
+}
+
 static void irq_deliver(CPU* c, uint32_t exc) {
     uint32_t ctx = mem_r32(0x800000D4);  // OSCurrentContext
     if (!ctx || (ctx & 0x3FFFFFFF) >= RAM_SIZE) fatal("interrupt with bad current context %08X (exc %u)", ctx, exc);
