+// tlbie on the 750 invalidates a congruence class, not one page: the TLB is 64 sets of two
+// ways, indexed by EA bits 14-19, and every translation in the named set goes -- only those
+// six bits of the operand matter. A game may rely on exactly that: pass just the set bits
+// (ea & 0x3F000) to drop whatever page sits in the set, or walk the 64 sets to flush the
+// whole TLB. So drop every software-TLB entry whose page falls in the same set, not only
+// the entry for the operand's page; dropping too many costs a page-table walk, keeping a
+// stale one lets the game read a frame it has already given away.
 extern "C" void hle_tlbie(CPU*, uint32_t ea) {
-    g_tlb[(ea >> 12) & (TLB_ENTRIES - 1)].store(0, std::memory_order_relaxed);
+    const uint32_t set = (ea >> 12) & 63;
+    for (uint32_t i = set; i < TLB_ENTRIES; i += 64) g_tlb[i].store(0, std::memory_order_relaxed);
 }
 
