+++ b/runtime/disc_picker.h
@@ -0,0 +1,10 @@
+#pragma once
+#include <string>
+
+// The disc image to boot: `given` if it is the disc this build was recompiled from, else the
+// one remembered in disc_path.txt, else (Windows) the player is asked to pick their own copy.
+// Empty if there is none or the player declined.
+std::string disc_pick(const char* given);
+
+// Whether the file is readable and carries this build's disc ID (plain or CISO image).
+bool disc_is_expected(const std::string& path);
