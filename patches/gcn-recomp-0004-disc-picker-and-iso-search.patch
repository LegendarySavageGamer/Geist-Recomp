diff --git a/runtime/disc_picker.cpp b/runtime/disc_picker.cpp
new file mode 100644
index 0000000..9b40fd3
--- /dev/null
+++ b/runtime/disc_picker.cpp
@@ -0,0 +1,119 @@
+// First-run disc selection: the program ships with no game data, so when it finds no image
+// it asks the player for their own copy, checks that it is the disc this build was made
+// from, and remembers the choice in disc_path.txt beside the program.
+#include "disc_picker.h"
+#include "platform.h"
+#include <SDL.h>
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <commdlg.h>
+#define GCN_WIDEN2(x) L##x
+#define GCN_WIDEN(x) GCN_WIDEN2(x)
+#endif
+
+bool disc_is_expected(const std::string& p);
+
+namespace {
+
+const char* kRemember = "disc_path.txt";
+
+// The six-character disc ID at the start of a plain image, or of a CISO's first block.
+std::string disc_id(const std::string& path) {
+    FILE* f = fopen(path.c_str(), "rb");
+    if (!f) return {};
+    unsigned char h[8] = {};
+    std::string id;
+    if (fread(h, 1, 8, f) == 8) {
+        long at = 0;
+        if (!memcmp(h, "CISO", 4)) at = 0x8000;  // first stored block (holds the header)
+        unsigned char b[6];
+        if (fseek(f, at, SEEK_SET) == 0 && fread(b, 1, 6, f) == 6) id.assign((const char*)b, 6);
+    }
+    fclose(f);
+    return id;
+}
+
+bool good(const std::string& p) { return disc_is_expected(p); }
+
+std::string remembered() {
+    FILE* f = fopen(kRemember, "rb");
+    if (!f) return {};
+    char buf[4096] = {};
+    size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+    fclose(f);
+    std::string s(buf, n);
+    while (!s.empty() && (s.back() == '\n' || s.back() == '\r' || s.back() == ' ')) s.pop_back();
+    return s;
+}
+
+void remember(const std::string& p) {
+    if (FILE* f = fopen(kRemember, "wb")) {
+        fputs(p.c_str(), f);
+        fclose(f);
+    }
+}
+
+#ifdef _WIN32
+std::string browse() {
+    wchar_t file[4096] = L"";
+    OPENFILENAMEW ofn = {};
+    ofn.lStructSize = sizeof(ofn);
+    ofn.lpstrFilter = L"GameCube disc image (*.iso;*.ciso;*.gcm)\0*.iso;*.ciso;*.gcm\0All files\0*.*\0";
+    ofn.lpstrFile = file;
+    ofn.nMaxFile = 4096;
+    ofn.lpstrTitle = L"Select your own " GCN_WIDEN(GCN_GAME_TITLE) L" disc image";
+    ofn.Flags = OFN_FILEMUSTEXIST | OFN_PATHMUSTEXIST | OFN_NOCHANGEDIR;
+    if (!GetOpenFileNameW(&ofn)) return {};
+    char utf8[8192];
+    int n = WideCharToMultiByte(CP_UTF8, 0, file, -1, utf8, sizeof(utf8), nullptr, nullptr);
+    return n > 0 ? std::string(utf8) : std::string();
+}
+#endif
+
+int ask(const char* title, const char* text, const char* yes, const char* no) {
+    const SDL_MessageBoxButtonData buttons[] = {
+        {SDL_MESSAGEBOX_BUTTON_ESCAPEKEY_DEFAULT, 0, no},
+        {SDL_MESSAGEBOX_BUTTON_RETURNKEY_DEFAULT, 1, yes},
+    };
+    SDL_MessageBoxData box = {SDL_MESSAGEBOX_INFORMATION, nullptr, title, text, 2, buttons, nullptr};
+    int hit = 0;
+    if (SDL_ShowMessageBox(&box, &hit) != 0) return 0;
+    return hit;
+}
+
+}  // namespace
+
+bool disc_is_expected(const std::string& p) { return !p.empty() && plat_readable(p.c_str()) && disc_id(p) == GCN_DISC_ID; }
+
+std::string disc_pick(const char* given) {
+    if (given && good(given)) return given;
+    std::string r = remembered();
+    if (good(r)) return r;
+#ifdef _WIN32
+    const char* intro =
+        "No game data is included with this program.\n\n"
+        "Select a disc image of your own copy of " GCN_GAME_TITLE " (disc " GCN_DISC_ID ").\n"
+        "It is only read, never changed, and the location is remembered for next time.";
+    if (!ask(GCN_GAME_TITLE, intro, "Select disc image...", "Quit")) return {};
+    for (;;) {
+        std::string p = browse();
+        if (p.empty()) return {};
+        const std::string id = disc_id(p);
+        if (id == GCN_DISC_ID) {
+            remember(p);
+            return p;
+        }
+        std::string msg = "That file is not the right disc.\n\nExpected disc ID " GCN_DISC_ID ", found ";
+        msg += id.size() == 6 ? "\"" + id + "\"" : std::string("no GameCube disc header");
+        msg += ".\nCompressed .rvz/.gcz images must be converted to .iso first (Dolphin: right-click > Convert File).";
+        if (!ask(GCN_GAME_TITLE, msg.c_str(), "Choose another...", "Quit")) return {};
+    }
+#else
+    return given ? given : "";
+#endif
+}
