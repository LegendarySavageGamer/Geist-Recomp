--- a/runtime/gx/fifo.cpp
+++ b/runtime/gx/fifo.cpp
@@ -474,7 +474,15 @@ static void cp_watermarks() {
     if (!(g_cp_cr & CP_CR_LINK)) return;
     uint32_t base = g_cp_base & 0x03FFFFE0, end = cp_end_excl();
