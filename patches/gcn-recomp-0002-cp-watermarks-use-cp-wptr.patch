-    uint32_t wptr = pi_fifo_wptr() & 0x03FFFFE0, r = g_cp_rptr & 0x03FFFFE0;
+    // The distance is the CP's: from its read pointer to its own write pointer, which moves
+    // only with a burst out of the gather pipe (cp_follow_pi), as the hardware's
