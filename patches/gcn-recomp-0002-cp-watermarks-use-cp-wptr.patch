+    // interrupt suspended the writing thread, and with nothing left for the GP to read, the
+    // underflow that resumes it never came.
+    uint32_t wptr = g_cp_wptr & 0x03FFFFE0, r = g_cp_rptr & 0x03FFFFE0;
     if (r < base || r >= end) r = base;
     if (wptr < base || wptr >= end) return;
     uint32_t d = wptr >= r ? wptr - r : (end - r) + (wptr - base);
