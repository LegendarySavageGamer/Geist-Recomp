+// Disc timing. By default a read lands in RAM the moment the game issues it and completes
+// after a short, fast "transfer", which keeps loading quick. A real drive seeks and streams:
+// nothing reaches RAM until well after the command, and a game can rely on that without
+// knowing it -- hand the drive a buffer it is still releasing (say, page frames another
+// thread is evicting) and the hardware's latency hides the race. di_set_timing (a game's
+// hook, or GCN_DVD_TIMING=<KB/s>,<seek us> to try it) delivers each read at its completion
+// instead, after a seek and at the given rate.
+static bool g_deliver_at_completion;
+static uint64_t g_bytes_per_sec = 64ull << 20, g_seek_us = 100;
+struct PendingRead { bool active; uint64_t offset; uint32_t dst, len; };
+static PendingRead g_pending;
+
+void di_set_timing(bool deliver_at_completion, uint32_t bytes_per_second, uint32_t seek_us) {
+    g_deliver_at_completion = deliver_at_completion;
+    if (bytes_per_second) g_bytes_per_sec = bytes_per_second;
+    g_seek_us = seek_us;
+}
+
+static void di_timing_from_env() {
+    static bool done;
+    if (done) return;
+    done = true;
+    if (const char* e = getenv("GCN_DVD_TIMING")) {
+        unsigned kbs = 0, seek = 0;
+        if (sscanf(e, "%u,%u", &kbs, &seek) >= 1 && kbs) di_set_timing(true, kbs * 1024u, seek);
+    }
+}
+
+static void dvd_deliver(uint64_t offset, uint32_t dst, uint32_t len) {
+    const uint32_t fit = dma_fit("DVD", dst, len);
+    debug_guest_check("before DVD read");
+    if (fit && !iso_read(offset, phys_ptr(dst), fit))
+        LOG(LOG_DVD, "read past end of image");
+    debug_guard_dma("DVD read", dst, len);
+    debug_guest_check("after DVD read");
+}
+
 static void di_update_irq() {
     bool irq = ((g_disr & 0x10) && (g_disr & 0x08)) || ((g_disr & 0x04) && (g_disr & 0x02)) ||
                ((g_disr & 0x40) && (g_disr & 0x20)) || ((g_dicvr & 0x04) && (g_dicvr & 0x02));
@@ -56,6 +95,10 @@ static void di_update_irq() {
 }
 
 static void di_complete() {
+    if (g_pending.active) {  // the data arrives as the transfer ends, as on the hardware
+        g_pending.active = false;
+        dvd_deliver(g_pending.offset, g_pending.dst, g_pending.len);
+    }
     g_busy = false;
     g_dicr &= ~1u;
     g_disr |= 0x10;  // TCINT
@@ -63,23 +106,20 @@ static void di_complete() {
 }
 
 static void di_execute() {
+    di_timing_from_env();
     uint32_t cmd = g_cmd[0] >> 24;
-    uint64_t delay = TB_FREQ / 10000;  // 100us base latency
+    uint64_t delay = TB_FREQ / 1000000 * g_seek_us;  // seek / command latency (100us by default)
     switch (cmd) {
     case 0xA8: {
         uint32_t sub = (g_cmd[0] >> 16) & 0xFF;
         uint64_t offset = sub == 0x40 ? 0 : (uint64_t)g_cmd[1] << 2;
         uint32_t len = g_dilen;
         LOG(LOG_DVD, "read off=%09llX len=%X -> %08X", (unsigned long long)offset, len, g_dimar);
-        const uint32_t fit = dma_fit("DVD", g_dimar, len);
-        debug_guest_check("before DVD read");
-        if (fit && !iso_read(offset, phys_ptr(g_dimar), fit))
-            LOG(LOG_DVD, "read past end of image");
-        debug_guard_dma("DVD read", g_dimar, len);
-        debug_guest_check("after DVD read");
+        if (g_deliver_at_completion) g_pending = {true, offset, g_dimar, len};
+        else dvd_deliver(offset, g_dimar, len);
         g_dimar += len;
         g_dilen = 0;
-        delay += (uint64_t)len * TB_FREQ / (64 << 20);  // ~64MB/s
+        delay += (uint64_t)len * TB_FREQ / g_bytes_per_sec;  // ~64MB/s unless a game asks for the drive's pace
         break;
     }
     case 0x12: {  // inquiry
