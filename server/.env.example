# Copy to .env. No DuckDNS credentials belong here: the relay never needs them.
GEIST_PUBLIC_PORT=47720
GEIST_MAX_PLAYERS=16
GEIST_DEFAULT_PLAYERS=16
GEIST_RECONNECT_GRACE_S=45
GEIST_HANDOFF_TIMEOUT_S=20
GEIST_CONN_TIMEOUT_S=10
GEIST_PPS=200
GEIST_CODE_TRIES_PER_MIN=10
GEIST_MAX_ROOMS=256
# GEIST_REQUIRE_BUILD=0.1.0
